# ─── Pickmatch backend env (local dev) ──────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Generate SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Required: JWT signing secret (H1 fix) ──────────────────────
# 32+ random bytes from secrets.token_urlsafe. NEVER use a
# developer-readable string ("password123", project name, etc.)
SECRET_KEY=

# ── Database (omit for default SQLite) ─────────────────────────
# SQLite (DEFAULT):
DATABASE_URL=sqlite+aiosqlite:///./pickmatch.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/pickmatch

# ── URLs ───────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ── App config ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
DEBUG=true

# ── JWT TTL (minutes) — defaults to 7 days ─────────────────────
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Rate limits (slowapi format: "<count>/<period>") ─────────────
# Per-IP on unauthenticated routes, per-user (JWT) on authenticated.
# Tweak these from the Render dashboard without redeploying the code.
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=3/hour
# RATE_LIMIT_FORGOT_PASSWORD=3/hour
# RATE_LIMIT_RESEND_VERIFICATION=5/hour
# RATE_LIMIT_RESET_PASSWORD=5/minute
# RATE_LIMIT_VOTE=60/minute
# RATE_LIMIT_VOTE_SESSION=30/minute
# RATE_LIMIT_COMMENT=30/minute
# RATE_LIMIT_COMMENT_LIKE=60/minute
# RATE_LIMIT_ALBUM_CREATE=10/hour
# RATE_LIMIT_SHARE_TOKEN_GET=30/hour
# RATE_LIMIT_SHARE_TOKEN_ROTATE=10/hour
# RATE_LIMIT_SHARE_ANALYTICS_BY_TOKEN=30/minute
# RATE_LIMIT_AVATAR_UPLOAD=30/minute

# ── Trusted reverse proxies (X-Forwarded-For) ──────────────────
# Comma-separated IPs/CIDRs that uvicorn trusts to set X-Forwarded-For.
# DO NOT set to "*" -- that lets clients forge XFF and bypass the
# per-IP rate limits. Empty -> trust only 127.0.0.1 (means no XFF trust
# on prod). For Render, populate from https://render.com/docs/static-ips
# with the ingress IPs you'd want to allow.
# TRUSTED_PROXY_IPS=

# ── Cloudinary (optional, prod) ────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Email (Resend) ─────────────────────────────────────────────
# RESEND_API_KEY=
