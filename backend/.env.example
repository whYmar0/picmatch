# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL DEV: SQLite (default, no installation needed / PostgreSQL не нужен)
DATABASE_URL=sqlite+aiosqlite:///./pickmatch.db

# PRODUCTION: uncomment and fill in PostgreSQL / раскомментировать для продакшна
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pickmatch

# ─── JWT Security ─────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── App ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
DEBUG=true
PORT=8000
