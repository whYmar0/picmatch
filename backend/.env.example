[TEMPLATE]
# ─── Database ─────────────────────────────────────────────────────────────────
# LOCAL DEV: SQLite (default, no installation needed / PostgreSQL не нужен)
DATABASE_URL=sqlite+aiosqlite:///./pickmatch.db

# PRODUCTION: uncomment and fill in PostgreSQL / раскомментировать для продакшна
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pickmatch

# ─── JWT Security ─────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-32-chars-minimum

# Access token lifetime. Default 10080 minutes = 7 days.
# For production persistence (auto-logout after inactivity), use 43200 (30 days)
# or higher. Long-lived tokens should be paired with a `/auth/refresh` endpoint.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── App ──────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# Render: mount a Persistent Disk at /var/data and set /var/data/uploads here.
UPLOAD_DIR=./uploads
ENVIRONMENT=development
DEBUG=true
PORT=8000

# ─── Cloudinary Image Storage ─────────────────────────────────────────────────
# Leave blank to store uploads locally in UPLOAD_DIR.
# All uploaded photo public_id values use uuid4(), so each asset is unique and
# overwrite=True only replaces its own previous version. Cloudinary URLs do NOT
# expire by default. Monitor monthly credits (free tier ~25 GB/25k assets).
# Do not enable "Strict transformations" in the Cloudinary dashboard unless you
# also sign URLs in cloudinary_utils.py.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email Configuration ──────────────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=noreply@pickmatch.site
RESEND_ALLOWED_DOMAIN=pickmatch.site

# Optional SMTP fallback
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
